# ---------------------------------------------------------------------
# Copie este arquivo para .env e preencha os valores.
# O .env real nunca deve ser versionado.
# ---------------------------------------------------------------------

# Porta: em desenvolvimento use 3000. Render/Railway injetam essa variável
# automaticamente, então não a defina manualmente na nuvem.
PORT=3000

# Banco de dados — opção A: URL única (Railway, Aiven)
# Quando preenchida, ignora as variáveis separadas abaixo.
# DATABASE_URL=mysql://usuario:senha@host:porta/banco

# Banco de dados — opção B: parâmetros separados (MySQL local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jogos_estudantis

# Bancos em nuvem exigem TLS. Deixe true em produção e false/vazio no local.
DB_SSL=false

# Segredo para assinar os tokens de login. OBRIGATÓRIO.
# Gere um valor novo e único para produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Domínios do frontend autorizados a consumir a API (separados por vírgula).
# Vazio libera qualquer origem — use apenas em desenvolvimento.
# CORS_ORIGIN=https://seu-site.vercel.app,https://www.seudominio.com

# Defina como production na nuvem: ativa a validação estrita das variáveis do banco.
NODE_ENV=development
